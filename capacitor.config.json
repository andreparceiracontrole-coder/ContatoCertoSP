{
  "appId": "com.contatocerto.sp",
  "appName": "Contato Certo SP",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://contatocertosp.vercel.app",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}